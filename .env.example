PORT=3000

# PostgreSQL Connection String (Provided automatically by Railway PostgreSQL or configure manually)
# Optional: If not provided, falls back to local data/database.json
DATABASE_URL=postgresql://postgres:password@localhost:5432/railway

# Required for Discord-only login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback
DISCORD_GUILD_ID=

# Comma-separated Discord role IDs. Admins get full controls; boosters get normal ledger access.
DISCORD_ADMIN_ROLE_IDS=
DISCORD_BOOSTER_ROLE_IDS=

# Change for production.
SESSION_SECRET=change-this-long-random-secret
SESSION_MAX_AGE_HOURS=12

# Set true when the site is served over HTTPS.
COOKIE_SECURE=false
